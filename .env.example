# Server Configuration
PORT=5001

# Database - MongoDB Atlas or local
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name
# OR for local development: MONGODB_URI=mongodb://localhost:27017/btb_db

# API Keys - Get these from:
# OpenCage: https://opencagedata.com/api
# Mapbox: https://account.mapbox.com/
# HERE: https://developer.here.com/
# Google Cloud: https://console.cloud.google.com/
OPENCAGE_API_KEY=your_opencage_key_here
REACT_APP_MAPBOX_TOKEN=pk.your_mapbox_token_here
HERE_API_KEY=your_here_key_here
GOOGLE_API_KEY=your_google_key_here

# Frontend API URL
REACT_APP_API_URL=http://localhost:5001
